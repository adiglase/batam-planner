{
  "name": "batam-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "demo:record": "playwright test e2e/app-demo.spec.ts --project=chrome-desktop",
    "dev": "node --env-file-if-exists=.env ./node_modules/@react-router/dev/bin.cjs dev",
    "start": "node --env-file-if-exists=.env ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chrome-phone --project=chrome-desktop --grep-invert @demo",
    "test:e2e:webkit": "playwright test --project=webkit-phone --project=webkit-desktop",
    "typecheck": "react-router typegen && tsc",
    "auth:migrate": "node --env-file-if-exists=.env scripts/auth-migrate.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "better-auth": "1.7.2",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.36",
    "lucide-react": "^1.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
