# Copy to .env. Local dev, production start, and auth:migrate load it with Node.
BETTER_AUTH_URL=http://localhost:5173
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used only to admit the first owner. Later logins use the bound Google identity.
OWNER_BOOTSTRAP_EMAIL=
# Optional; defaults to .data/batam-planner.sqlite
# DATABASE_PATH=/absolute/path/to/batam-planner.sqlite
# Optional public, browser-restricted Google Maps key (not a Google login secret).
# VITE_GOOGLE_MAPS_API_KEY=
